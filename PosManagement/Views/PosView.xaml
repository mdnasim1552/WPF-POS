<UserControl x:Class="PosManagement.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PosManagement.Views"
             mc:Ignorable="d" 
             Background="#F3F5F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Point of Sale"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#172033"/>

            <TextBlock Text="Search products, build a cart, and complete a sale."
                   Foreground="#667085"
                   Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <!-- Products -->
            <Border Grid.Column="0"
                Background="White"
                CornerRadius="10"
                Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Products"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                    <TextBox x:Name="SearchBox"
                         Grid.Row="1"
                         Height="36"
                         Margin="0,0,0,12"
                         Padding="8"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchBox_KeyDown"
                         ToolTip="Search by name, SKU, or scan a barcode"/>

                    <DataGrid Grid.Row="2"
                          ItemsSource="{Binding FilteredProducts}"
                          SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product"
                            Binding="{Binding Name}"
                            Width="*"/>

                            <DataGridTextColumn Header="SKU"
                            Binding="{Binding SKU}"
                            Width="85"/>

                            <DataGridTextColumn Header="Price"
                            Binding="{Binding SellingPrice,
                                StringFormat={}{0:N2}}"
                            Width="90"/>

                            <DataGridTextColumn Header="Stock"
                            Binding="{Binding StockQuantity}"
                            Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="3"
                        Content="Add Selected Product"
                        Command="{Binding AddToCartCommand}"
                        Height="42"
                        Margin="0,12,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- Cart and checkout -->
            <Border Grid.Column="2"
                Background="White"
                CornerRadius="10"
                Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Shopping Cart"
                               FontSize="19"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left"/>

                        <Button Content="Remove Item"
                            Command="{Binding RemoveCartItemCommand}"
                            DockPanel.Dock="Right"
                            Padding="10,5"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                          ItemsSource="{Binding CartItems}"
                          SelectedItem="{Binding SelectedCartItem}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product"
                            Binding="{Binding ProductName}"
                            IsReadOnly="True"
                            Width="*"/>

                            <DataGridTextColumn Header="Price"
                            Binding="{Binding UnitPrice,
                                StringFormat={}{0:N2}}"
                            IsReadOnly="True"
                            Width="85"/>

                            <DataGridTextColumn Header="Qty"
                            Binding="{Binding Quantity,
                                UpdateSourceTrigger=PropertyChanged}"
                            Width="55"/>

                            <DataGridTextColumn Header="Total"
                            Binding="{Binding LineTotal,
                                StringFormat={}{0:N2}}"
                            IsReadOnly="True"
                            Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Items"
                                   Foreground="#667085"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding CartItemCount}"
                                   FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Subtotal"
                                   VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding Subtotal,
                                       StringFormat={}{0:N2}}"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Discount"
                                   VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                 Text="{Binding Discount,
                                     UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6"
                                 HorizontalContentAlignment="Right"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Tax rate (%)"
                                   VerticalAlignment="Center"
                                   Width="100"/>

                            <TextBox Width="90"
                                 Padding="6"
                                 Text="{Binding TaxRate,
                                 UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="{Binding TaxAmount,
                                   StringFormat='Tax: {0:N2}'}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                        <Separator Margin="0,4,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="TOTAL"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding Total,
                                       StringFormat={}{0:N2}}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"/>
                        </Grid>

                        <TextBlock Text="Payment method"
                               Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding PaymentMethods}"
                              SelectedItem="{Binding PaymentMethod}"
                              Height="35"
                              Margin="0,0,0,10"/>

                        <TextBlock Text="Amount received (cash)"
                               Margin="0,0,0,5"/>

                        <TextBox Text="{Binding AmountReceived,
                                UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="8"
                             Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Change"
                                   VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding ChangeAmount,
                                       StringFormat={}{0:N2}}"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        </Grid>

                        <Button Content="COMPLETE SALE"
                            Command="{Binding CheckoutCommand}"
                            Height="48"
                            Background="#15803D"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="15"
                            BorderThickness="0"/>

                        <Button Content="Clear Cart"
                            Command="{Binding ClearCartCommand}"
                            Height="35"
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
               Text="{Binding StatusMessage}"
               Foreground="#475467"
               TextWrapping="Wrap"
               Margin="0,12,0,0"/>
    </Grid>
</UserControl>
