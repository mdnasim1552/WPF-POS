<UserControl x:Class="PosManagement.Views.ReturnHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PosManagement.Views"
             mc:Ignorable="d" 
             Background="#F4F6F9">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Return History"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#121820"/>

            <TextBlock Text="Review returns, refunds and daily summaries."
                       FontSize="13"
                       Foreground="#718096"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Filters -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Invoice Number"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             VerticalContentAlignment="Center"
                             ToolTip="Search by invoice number"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Start Date"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding StartDate}"
                                Height="34"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="End Date"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding EndDate}"
                                Height="34"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Apply"
                        Command="{Binding LoadReturnsCommand}"
                        Height="34"
                        Margin="0,22,8,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button Grid.Column="4"
                        Content="Clear"
                        Command="{Binding ClearFiltersCommand}"
                        Height="34"
                        Margin="0,22,0,0"/>
            </Grid>
        </Border>

        <!-- Summary cards -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,6,0">

                <StackPanel>
                    <TextBlock Text="Total Returns"
                               Foreground="#718096"
                               FontSize="13"/>

                    <TextBlock Text="{Binding TotalReturnCount}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#121820"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="16"
                    Margin="6,0,0,0">

                <StackPanel>
                    <TextBlock Text="Total Refunded"
                               Foreground="#718096"
                               FontSize="13"/>

                    <TextBlock Text="{Binding TotalRefundAmount,
                                      StringFormat=N2}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#2563EB"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Return records -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,6,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Return Records"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Returns}"
                              SelectedItem="{Binding SelectedReturn}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="Invoice"
                                Binding="{Binding InvoiceNumber}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Return Date"
                                Binding="{Binding ReturnDate,
                                    StringFormat={}{0:dd-MMM-yyyy}}"
                                Width="105"/>

                            <DataGridTextColumn
                                Header="Refund"
                                Binding="{Binding RefundAmount,
                                    StringFormat=N2}"
                                Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Details and summaries -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="12"
                    Margin="6,0,0,0">

                <TabControl>

                    <!-- Details tab -->
                    <TabItem Header="Return Details">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Invoice"
                                               Foreground="#718096"/>
                                    <TextBlock Text="{Binding SelectedReturn.InvoiceNumber}"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,8"/>

                                    <TextBlock Text="Refund Method"
                                               Foreground="#718096"/>
                                    <TextBlock Text="{Binding SelectedReturn.RefundMethod}"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Return Date"
                                               Foreground="#718096"/>
                                    <TextBlock Text="{Binding SelectedReturn.ReturnDate,
                                        StringFormat={}{0:dd-MMM-yyyy HH:mm}}"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,8"/>

                                    <TextBlock Text="Reason"
                                               Foreground="#718096"/>
                                    <TextBlock Text="{Binding SelectedReturn.Reason}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding SelectedReturnItems}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product"
                                        Binding="{Binding ProductName}"
                                        Width="*"/>
                                    <DataGridTextColumn Header="Qty"
                                        Binding="{Binding Quantity}"
                                        Width="45"/>
                                    <DataGridTextColumn Header="Unit Price"
                                        Binding="{Binding UnitPrice, StringFormat=N2}"
                                        Width="85"/>
                                    <DataGridTextColumn Header="Refund"
                                        Binding="{Binding RefundAmount, StringFormat=N2}"
                                        Width="85"/>
                                    <DataGridTextColumn Header="Restock"
                                        Binding="{Binding RestockStatus}"
                                        Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding SelectedReturn.RefundAmount,
                                            StringFormat=Total Refund: {0:N2}}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Right"
                                       Margin="0,12,0,0"/>
                        </Grid>
                    </TabItem>

                    <!-- Daily summary -->
                    <TabItem Header="Daily Summary">
                        <DataGrid ItemsSource="{Binding DailySummaries}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Margin="8">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date"
                                    Binding="{Binding ReturnDate,
                                        StringFormat={}{0:dd-MMM-yyyy}}"
                                    Width="*"/>

                                <DataGridTextColumn Header="Returns"
                                    Binding="{Binding ReturnCount}"
                                    Width="80"/>

                                <DataGridTextColumn Header="Refund Amount"
                                    Binding="{Binding RefundAmount, StringFormat=N2}"
                                    Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Payment method summary -->
                    <TabItem Header="Payment Summary">
                        <DataGrid ItemsSource="{Binding PaymentMethodSummaries}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Margin="8">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Refund Method"
                                    Binding="{Binding RefundMethod}"
                                    Width="*"/>

                                <DataGridTextColumn Header="Returns"
                                    Binding="{Binding ReturnCount}"
                                    Width="80"/>

                                <DataGridTextColumn Header="Refund Amount"
                                    Binding="{Binding RefundAmount, StringFormat=N2}"
                                    Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#475569"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Print Return Receipt"
                    Click="PrintReceipt_Click"
                    Height="38"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"/>
        </Grid>
    </Grid>
</UserControl>
