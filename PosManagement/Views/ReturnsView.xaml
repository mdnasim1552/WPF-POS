<UserControl x:Class="PosManagement.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PosManagement.Views"
             mc:Ignorable="d"
             Background="#F4F6F9">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Return / Refund"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#121820"/>

            <TextBlock Text="Find a sale and process returned products."
                       FontSize="13"
                       Foreground="#718096"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Invoice search -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Invoice Number"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox Text="{Binding InvoiceNumber,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Search"
                        Command="{Binding SearchSaleCommand}"
                        Height="36"
                        Margin="12,22,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Return items -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Sold Items"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          RowHeight="42">

                    <DataGrid.Columns>

                        <DataGridCheckBoxColumn
                            Header="Return"
                            Binding="{Binding IsSelected,
                                      UpdateSourceTrigger=PropertyChanged}"
                            Width="65"/>

                        <DataGridTextColumn
                            Header="Product"
                            Binding="{Binding ProductName}"
                            IsReadOnly="True"
                            Width="*"/>

                        <DataGridTextColumn
                            Header="SKU"
                            Binding="{Binding SKU}"
                            IsReadOnly="True"
                            Width="110"/>

                        <DataGridTextColumn
                            Header="Sold"
                            Binding="{Binding SoldQuantity}"
                            IsReadOnly="True"
                            Width="65"/>

                        <DataGridTextColumn
                            Header="Previously Returned"
                            Binding="{Binding PreviouslyReturned}"
                            IsReadOnly="True"
                            Width="130"/>

                        <DataGridTextColumn
                            Header="Available"
                            Binding="{Binding RemainingQuantity}"
                            IsReadOnly="True"
                            Width="85"/>

                        <DataGridTextColumn
                            Header="Return Qty"
                            Binding="{Binding QuantityToReturn,
                                      UpdateSourceTrigger=PropertyChanged}"
                            Width="90"/>

                        <DataGridTextColumn
                            Header="Unit Price"
                            Binding="{Binding UnitPrice, StringFormat=N2}"
                            IsReadOnly="True"
                            Width="95"/>

                        <DataGridTextColumn
                            Header="Refund"
                            Binding="{Binding RefundAmount, StringFormat=N2}"
                            IsReadOnly="True"
                            Width="95"/>

                        <DataGridCheckBoxColumn
                            Header="Restock"
                            Binding="{Binding Restock,
                                      UpdateSourceTrigger=PropertyChanged}"
                            Width="75"/>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Refund total -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">

                    <TextBlock Text="Refund Total:"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding RefundTotal,
                                              StringFormat=N2}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#2563EB"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom controls -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#475569"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <TextBox Text="{Binding Reason,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Height="34"
                         Margin="0,8,12,0"
                         VerticalContentAlignment="Center"
                         ToolTip="Return reason (optional)"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8,0">
                <TextBlock Text="Refund Method"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <ComboBox ItemsSource="{Binding RefundMethods}"
                          SelectedItem="{Binding RefundMethod}"
                          Height="34"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="Process Return"
                    Command="{Binding ProcessReturnCommand}"
                    Height="38"
                    Margin="8,22,0,0"
                    Background="#16A34A"
                    Foreground="White"
                    BorderThickness="0"/>
        </Grid>
    </Grid>
</UserControl>
