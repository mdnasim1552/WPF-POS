<UserControl x:Class="PosManagement.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PosManagement.Views"
             mc:Ignorable="d" 
             Background="#F3F5F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Sales History"
               FontSize="24"
               FontWeight="Bold"
               Margin="0,0,0,14"/>

        <DataGrid Grid.Row="1"
              x:Name="SalesGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              ItemsSource="{Binding Sales}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Invoice"
                Binding="{Binding InvoiceNumber}"
                Width="2*"/>

                <DataGridTextColumn Header="Date"
                Binding="{Binding SaleDate, StringFormat={}{0:dd-MMM-yyyy HH:mm}}"
                Width="2*"/>

                <DataGridTextColumn Header="Subtotal"
                Binding="{Binding Subtotal, StringFormat={}{0:N2}}"
                Width="*"/>

                <DataGridTextColumn Header="Discount"
                Binding="{Binding Discount, StringFormat={}{0:N2}}"
                Width="*"/>

                <DataGridTextColumn Header="Total"
                Binding="{Binding Total, StringFormat={}{0:N2}}"
                Width="*"/>

                <DataGridTextColumn Header="Payment"
                Binding="{Binding PaymentMethod}"
                Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">

            <Button Content="Refresh"
                Click="Refresh_Click"
                Padding="16,8"
                Margin="0,0,8,0"/>

            <Button Content="Print Receipt"
                Click="PrintReceipt_Click"
                Padding="16,8"/>
        </StackPanel>
    </Grid>
</UserControl>
