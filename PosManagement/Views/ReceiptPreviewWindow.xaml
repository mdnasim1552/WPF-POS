<Window x:Class="PosManagement.Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosManagement.Views"
        mc:Ignorable="d"
        Title="Receipt Print Preview"
        Height="750"
        Width="950"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                Padding="12"
                CornerRadius="8"
                Margin="0,0,0,12">

            <DockPanel>
                <TextBlock Text="Receipt Preview"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">

                    <Button Content="Print"
                            Click="Print_Click"
                            Background="#2563EB"
                            Foreground="White"
                            Padding="25,9"
                            Margin="0,0,8,0"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <Button Content="Close"
                            Click="Close_Click"
                            Background="#E2E8F0"
                            Foreground="#334155"
                            Padding="20,9"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#CBD5E1"
                Padding="15"
                CornerRadius="8">

            <FlowDocumentReader x:Name="ReceiptReader"
                    ViewingMode="Page"
                    IsFindEnabled="False"
                    IsPrintEnabled="False"
                    IsPageViewEnabled="True"
                    IsTwoPageViewEnabled="False"
                    IsScrollViewEnabled="True"/>
        </Border>
    </Grid>
</Window>
