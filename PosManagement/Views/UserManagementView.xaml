<UserControl x:Class="PosManagement.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PosManagement.Views"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded">
    <Grid Background="#F4F6F9" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="User Management"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Manage system users, roles and account access."
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="+ New User"
                    Command="{Binding NewUserCommand}"
                    Background="#2563EB"
                    Foreground="White"
                    Padding="18,10"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Users list -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="15">

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="System Users"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <DataGrid ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              SelectionMode="Single">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username"
                                                Binding="{Binding Username}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Full Name"
                                                Binding="{Binding FullName}"
                                                Width="1.4*"/>

                            <DataGridTextColumn Header="Role"
                                                Binding="{Binding Role}"
                                                Width="*"/>

                            <DataGridCheckBoxColumn Header="Active"
                                                    Binding="{Binding IsActive}"
                                                    Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- User form -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="User Details"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Username"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35"
                                 Margin="0,5,0,15"/>

                        <TextBlock Text="Full Name"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35"
                                 Margin="0,5,0,15"/>

                        <TextBlock Text="Role"/>
                        <ComboBox ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding SelectedRole}"
                                  Height="35"
                                  Margin="0,5,0,15"/>

                        <TextBlock Text="Account Status"/>
                        <CheckBox Content="Active account"
                                  IsChecked="{Binding IsActive}"
                                  Margin="0,8,0,15"/>

                        <TextBlock Text="Password / New Password"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Height="35"
                                     Margin="0,5,0,5"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>

                        <TextBlock Text="For new users, enter an initial password. For existing users, use Reset Password."
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>

                        <Button Content="Save User"
                                Command="{Binding SaveUserCommand}"
                                Background="#2563EB"
                                Foreground="White"
                                Height="40"
                                BorderThickness="0"
                                Margin="0,0,0,10"/>

                        <Button Content="Reset Password"
                                Command="{Binding ResetPasswordCommand}"
                                Background="#E5E7EB"
                                Foreground="#172033"
                                Height="40"
                                BorderThickness="0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="#475569"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
