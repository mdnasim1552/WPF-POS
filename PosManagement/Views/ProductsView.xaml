<UserControl x:Class="PosManagement.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PosManagement.Views"
             xmlns:services="clr-namespace:PosManagement.Services"
             mc:Ignorable="d" 
             Background="#F3F5F9">
    <UserControl.Resources>
        <services:ProductImageConverter
        x:Key="ProductImageConverter"/>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer
              VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26">

                <TextBlock Text="Product Management"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#172033"/>

                <TextBlock Text="Manage products, categories, prices and stock."
                   Foreground="#64748B"
                   Margin="0,6,0,20"/>

                <!-- Product form -->
                <Border Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,18">

                    <StackPanel>
                        <TextBlock Text="Product Details"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0"
                                Margin="0,0,12,12">
                                <TextBlock Text="Product Name"
                                   Margin="0,0,0,5"/>
                                <TextBox Text="{Binding ProductName,
                            UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1"
                                Margin="0,0,12,12">
                                <TextBlock Text="SKU"
                                   Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Sku,
                            UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2"
                                Margin="0,0,0,12">
                                <TextBlock Text="Barcode"
                                   Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Barcode,
                            UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0"
                                Margin="0,0,12,12">
                                <TextBlock Text="Cost Price"
                                   Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CostPriceText,
                            UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1"
                                Margin="0,0,12,12">
                                <TextBlock Text="Selling Price"
                                   Margin="0,0,0,5"/>
                                <TextBox Text="{Binding SellingPriceText,
                            UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2"
                                Margin="0,0,0,12">
                                <TextBlock Text="Current Stock"
                                   Margin="0,0,0,5"/>
                                <TextBox Text="{Binding StockQuantityText,
                            UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0"
                                Margin="0,0,12,12">
                                <TextBlock Text="Reorder Level"
                                   Margin="0,0,0,5"/>
                                <TextBox Text="{Binding ReorderLevelText,
                            UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1"
                                Margin="0,0,12,12">
                                <TextBlock Text="Category"
                                   Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="Name"
                                  Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2"
                                Margin="0,0,0,12">
                                <TextBlock Text="New Category"
                                   Margin="0,0,0,5"/>
                                <DockPanel>
                                    <Button Content="Add"
                                    Command="{Binding AddCategoryCommand}"
                                    DockPanel.Dock="Right"
                                    Padding="12,5"
                                    Margin="6,0,0,0"/>
                                    <TextBox Text="{Binding NewCategoryName,
                                UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"/>
                                </DockPanel>
                            </StackPanel>
                            <!-- Compact Product Image Section -->
                            <Border Grid.Row="0"
                                    Grid.Column="3"
                                    Grid.RowSpan="3"
                                    Margin="10,0,0,12"
                                    Padding="10"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right">
                            
                                <StackPanel Width="155">
                            
                                    <TextBlock Text="Product Image"
                                               FontWeight="SemiBold"
                                               Foreground="#344054"
                                               FontSize="13"
                                               Margin="0,0,0,8"/>
                            
                                    <!-- Image Preview -->
                                    <Border Width="110"
                                            Height="90"
                                            HorizontalAlignment="Center"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4">
                            
                                        <Image Source="{Binding ProductImagePreview}"
                                               Stretch="Uniform"/>
                                    </Border>
                            
                                    <!-- Image Actions -->
                                    <UniformGrid Columns="2"
                                                 Margin="0,10,0,0">
                            
                                        <Button Content="Browse"
                                                Command="{Binding BrowseProductImageCommand}"
                                                Margin="0,0,4,0"
                                                Padding="6,7"
                                                FontSize="11"
                                                Background="#2563EB"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                            
                                        <Button Content="Remove"
                                                Command="{Binding RemoveProductImageCommand}"
                                                Margin="4,0,0,0"
                                                Padding="6,7"
                                                FontSize="11"
                                                Background="#FEE2E2"
                                                Foreground="#991B1B"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                            
                                    </UniformGrid>
                            
                                    <TextBlock Text="JPG, PNG, BMP, GIF"
                                               FontSize="10"
                                               Foreground="#98A2B3"
                                               HorizontalAlignment="Center"
                                               Margin="0,7,0,0"/>
                            
                                </StackPanel>
                            </Border>
                            <!-- Action Buttons -->
                            <Border Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Margin="0,16,0,0"
                                    Padding="0,14,0,0"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="0,1,0,0">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                        <!-- New -->
                                        <Button Content="＋  New"
                                                Command="{Binding NewProductCommand}"
                                                MinWidth="95"
                                                Padding="16,10"
                                                Margin="0,0,10,0"
                                                Background="#F1F5F9"
                                                Foreground="#334155"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"/>

                                        <!-- Save -->
                                        <Button Content="Save Product"
                                                Command="{Binding SaveProductCommand}"
                                                MinWidth="135"
                                                Padding="18,10"
                                                Margin="0,0,10,0"
                                                Background="#2563EB"
                                                Foreground="White"
                                                BorderBrush="#2563EB"
                                                BorderThickness="1"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"/>

                                        <!-- Deactivate -->
                                        <Button Content="Deactivate"
                                                Command="{Binding DeactivateProductCommand}"
                                                MinWidth="115"
                                                Padding="16,10"
                                                Background="#FEF2F2"
                                                Foreground="#DC2626"
                                                BorderBrush="#FECACA"
                                                BorderThickness="1"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Search -->
                <Border Background="White"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,18">

                    <StackPanel>
                        <TextBlock Text="Search Products"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                        <TextBox Text="{Binding SearchText,
                            UpdateSourceTrigger=PropertyChanged}"
                         Padding="10"
                         ToolTip="Search by product name, SKU or barcode"/>
                    </StackPanel>
                </Border>

                <!-- Product table -->
                <Border Background="White"
                CornerRadius="12"
                Padding="18">

                    <StackPanel>
                        <TextBlock Text="Product List"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                        <DataGrid ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="38"
                                  MinHeight="240"
                                  MaxHeight="390">
                            <DataGrid.Resources>
                                <Style x:Key="CenteredCellTextStyle" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding ProductId}"
                                                    Width="55" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                                <DataGridTemplateColumn Header="Image" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="42"
                                                    Height="42"
                                                    Background="#F3F5F9"
                                                    CornerRadius="5"
                                                    Padding="2">

                                                <Image Source="{Binding ImagePath,
                                                       Converter={StaticResource ProductImageConverter}}"
                                                       Stretch="Uniform"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Product"
                                                    Binding="{Binding Name}"
                                                    Width="2*" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTextColumn Header="SKU"
                                                    Binding="{Binding SKU}"
                                                    Width="*" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category.Name}"
                                                    Width="*" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTextColumn Header="Price"
                                                    Binding="{Binding SellingPrice,
                                                    StringFormat={}{0:N2}}"
                                                    Width="*" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTextColumn Header="Stock"
                                                    Binding="{Binding StockQuantity}"
                                                    Width="65" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTextColumn Header="Reorder At"
                                                    Binding="{Binding ReorderLevel}"
                                                    Width="85" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTemplateColumn Header="Status" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StockStatus}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#15803D"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StockStatus}" Value="Low Stock">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding StockStatus}" Value="Out of Stock">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#475569"
                           Margin="0,14,0,0"
                           TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
