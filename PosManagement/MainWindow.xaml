<Window x:Class="PosManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosManagement"
        mc:Ignorable="d"
        Title="POS Management"
        Height="760"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#172033">
            <DockPanel Margin="18">

                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,30">
                    <TextBlock Text="POS MANAGEMENT"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="Bold"/>

                    <TextBlock Text="Retail Store"
                               Foreground="#AEBBD0"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel>
                    <Border Background="#2B3A55"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,8">
                        <TextBlock Text="📦  Products"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Text="🛒  POS / Sales"
                               Foreground="#CBD5E1"
                               Margin="12,12"/>

                    <TextBlock Text="📊  Dashboard"
                               Foreground="#CBD5E1"
                               Margin="12,12"/>

                    <TextBlock Text="📋  Inventory"
                               Foreground="#CBD5E1"
                               Margin="12,12"/>

                    <TextBlock Text="📈  Reports"
                               Foreground="#CBD5E1"
                               Margin="12,12"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Version 1.0"
                           Foreground="#94A3B8"
                           Margin="0,20,0,0"/>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="28">

                <TextBlock Text="Product Management"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Manage products, prices and stock."
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,6,0,22"/>

                <!-- Add product form -->
                <Border Background="White"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Add New Product"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0"
                                        Margin="0,0,12,14">
                                <TextBlock Text="Product Name"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ProductName,
                                    UpdateSourceTrigger=PropertyChanged}"
                                         Padding="9"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1"
                                        Margin="0,0,12,14">
                                <TextBlock Text="SKU"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Sku,
                                    UpdateSourceTrigger=PropertyChanged}"
                                         Padding="9"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2"
                                        Margin="0,0,0,14">
                                <TextBlock Text="Barcode (optional)"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Barcode,
                                    UpdateSourceTrigger=PropertyChanged}"
                                         Padding="9"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0"
                                        Margin="0,0,12,14">
                                <TextBlock Text="Cost Price"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CostPriceText,
                                    UpdateSourceTrigger=PropertyChanged}"
                                         Padding="9"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1"
                                        Margin="0,0,12,14">
                                <TextBlock Text="Selling Price"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding SellingPriceText,
                                    UpdateSourceTrigger=PropertyChanged}"
                                         Padding="9"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2"
                                        Margin="0,0,0,14">
                                <TextBlock Text="Opening Stock"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding StockQuantityText,
                                    UpdateSourceTrigger=PropertyChanged}"
                                         Padding="9"/>
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Grid.Column="2"
                                    Content="Add Product"
                                    Command="{Binding AddProductCommand}"
                                    Height="40"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Product list -->
                <Border Background="White"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="Products"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <DataGrid ItemsSource="{Binding Products}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="42"
                                  MinHeight="240"
                                  MaxHeight="390">
                            <DataGrid.Resources>
                                <Style x:Key="CenteredCellTextStyle" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                    Binding="{Binding ProductId}"
                                    Width="55" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTextColumn Header="Product"
                                    Binding="{Binding Name}"
                                    Width="2*" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTextColumn Header="SKU"
                                    Binding="{Binding SKU}"
                                    Width="*" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTextColumn Header="Barcode"
                                    Binding="{Binding Barcode}"
                                    Width="*" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTextColumn Header="Cost"
                                    Binding="{Binding CostPrice,
                                        StringFormat={}{0:N2}}"
                                    Width="*" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTextColumn Header="Selling Price"
                                    Binding="{Binding SellingPrice,
                                        StringFormat={}{0:N2}}"
                                    Width="*" ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                                <DataGridTextColumn Header="Stock"
                                    Binding="{Binding StockQuantity}"
                                    Width="70" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#475569"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
