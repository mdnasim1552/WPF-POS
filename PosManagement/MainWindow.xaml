<Window x:Class="PosManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosManagement"
        mc:Ignorable="d"
        Title="POS Management"
        Height="780"
        Width="1280"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Persistent sidebar -->
        <Border Grid.Column="0"
                Background="#172033">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top"
                            Margin="18,24,18,24">
                    <TextBlock Text="POS MANAGEMENT"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Retail Management System"
                               FontSize="11"
                               Foreground="#AAB5C8"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="WORKSPACE"
                               Foreground="#8E9AB0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="18,8,0,10"/>

                    <Button Content="  POS / Sales"
                            Command="{Binding ShowPosCommand}"
                            Style="{StaticResource NavigationButtonStyle}"/>

                    <Button Content="  Products"
                            Command="{Binding ShowProductsCommand}"
                            Style="{StaticResource NavigationButtonStyle}"/>

                    <Button Content="  Sales History"
                            Command="{Binding ShowSalesHistoryCommand}"
                            Style="{StaticResource NavigationButtonStyle}"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E4E7EC"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPageTitle}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="Retail POS"
                               DockPanel.Dock="Right"
                               Foreground="#667085"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentView}"
                            Margin="18"/>
        </Grid>
    </Grid>
</Window>
