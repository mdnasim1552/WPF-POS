 <Window x:Class="PosManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosManagement"
        mc:Ignorable="d"
        Title="POS Management"
        Height="780"
        Width="1280"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#172033">

            <DockPanel LastChildFill="True">

                <!-- Application branding -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="20,26,18,28">

                    <TextBlock Text="POS MANAGEMENT"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Retail Management System"
                               FontSize="11"
                               Foreground="#AAB5C8"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <!-- Logged-in user information -->
                <Border DockPanel.Dock="Bottom"
                        Background="#202D43"
                        Padding="16,15"
                        Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SIGNED IN AS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#8E9AB0"/>

                            <TextBlock Text="{Binding CurrentUserName}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,7,0,2"/>

                            <TextBlock Text="{Binding CurrentUserRole}"
                                       FontSize="11"
                                       Foreground="#AAB5C8"/>
                            
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding LogoutCommand}"
                                ToolTip="Logout"
                                Cursor="Hand"
                                Content="&#x23FB;"
                                Foreground="#DC2626"
                                Style="{StaticResource NavigationButtonStyle}"
                                />
                    </Grid>
                    
                </Border>
    
                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Workspace -->
                        <TextBlock Text="WORKSPACE"
                                   Foreground="#8E9AB0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="18,8,0,12"/>

                        <Button Content="  POS / Sales"
                                Command="{Binding ShowPosCommand}"
                                Style="{StaticResource NavigationButtonStyle}"/>

                        <Button Content="  Products"
                                Command="{Binding ShowProductsCommand}"
                                Style="{StaticResource NavigationButtonStyle}"
                                Visibility="{Binding CanManageProducts,
                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Content="  Sales History"
                                Command="{Binding ShowSalesHistoryCommand}"
                                Style="{StaticResource NavigationButtonStyle}"
                                Visibility="{Binding CanViewSalesHistory,
                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Content="  Return / Refund"
                                Command="{Binding ShowReturnsCommand}"
                                Style="{StaticResource NavigationButtonStyle}"
                                Visibility="{Binding CanProcessReturns,
                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Content="  Return History"
                                Command="{Binding ShowReturnHistoryCommand}"
                                Style="{StaticResource NavigationButtonStyle}"
                                Visibility="{Binding CanViewReturnHistory,
                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Administration -->
                        <Border Height="1"
                                Background="#354158"
                                Margin="18,18,18,14"/>

                        <TextBlock Text="ADMINISTRATION"
                                   Foreground="#8E9AB0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="18,0,0,12"/>

                        <Button Content="  User Management"
                                Command="{Binding ShowUserManagementCommand}"
                                Style="{StaticResource NavigationButtonStyle}"
                                Visibility="{Binding IsAdmin,
                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main content area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E4E7EC"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">

                <DockPanel VerticalAlignment="Center">

                    <TextBlock Text="{Binding CurrentPageTitle}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               VerticalAlignment="Center"/>

                    <StackPanel DockPanel.Dock="Right"
                                VerticalAlignment="Center">

                        <TextBlock Text="Retail POS"
                                   Foreground="#667085"
                                   FontSize="12"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="{Binding CurrentUserRole}"
                                   Foreground="#98A2B3"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- Dynamic page -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentView}"
                            Margin="18"/>
        </Grid>
    </Grid>
</Window>